json { "outputs": [ ["video-h264-360p", "audio-aac-128kbps"], ["video-h264-360p", "audio-aac-64kbps"], ["video-h264-360p-lowest", "audio-aac-128kbps"], ["video-h264-360p-lowest", "audio-aac-64kbps"] ] }
